{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": "./dist-types",
    "rootDir": ".",
    "noEmit": false,
    "types": ["vite/client", "vite-plugin-pwa/client"]
  },
  // Tests are included on purpose. Left out, a screen test can drift from the
  // response contract and only say so when it runs, which is exactly the
  // drift the shared types exist to prevent.
  "include": ["src/**/*", "test/**/*", "preview/**/*"],
  "references": [{ "path": "../shared" }]
}
