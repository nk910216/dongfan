{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // A configuration file of its own, holding nothing but a scratch database
  // for the statistics fixture.
  //
  // Separate from packages/api/wrangler.jsonc for the same reason the
  // restore drill is: adding this binding there would make `wrangler deploy`
  // look for a deployed database called dongfan-stats, which does not and
  // must not exist. Keeping it here means the fixture can never reach
  // anything real, and a deploy can never trip over the fixture.
  //
  // It is also not dongfan-dev. A year of invented records would bury the
  // handful of real test records the owner develops against, and the point
  // of this database is that it can be filled and emptied freely.
  //
  // Local only. Nothing in this repository passes --remote with it.
  "name": "dongfan-stats-fixture",
  "compatibility_date": "2025-09-06",
  "d1_databases": [
    {
      "binding": "STATS",
      "database_name": "dongfan-stats",
      "database_id": "local-stats-placeholder",
      "migrations_dir": "../packages/api/migrations"
    }
  ]
}
