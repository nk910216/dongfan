{
  "name": "dongfan",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @dongfan/web",
    "dev:api": "npm run build -w @dongfan/web && npm run dev -w @dongfan/api",
    "build": "npm run build -w @dongfan/shared && npm run build -w @dongfan/web",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "test": "vitest run && npm run test -w @dongfan/api",
    "check:lang": "node scripts/check-language.mjs",
    "db:migrate": "npm run build -w @dongfan/shared && npm run db:migrate -w @dongfan/api",
    "db:seed": "npm run build -w @dongfan/shared && node scripts/seed.mjs",
    "users": "npm run build -w @dongfan/shared && node scripts/users.mjs",
    "test:web": "vitest run",
    "test:api": "npm run test -w @dongfan/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.4"
  }
}