# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-types/
build/
*.tsbuildinfo

# Cloudflare Wrangler
# .dev.vars holds local secrets; .wrangler/ holds the local D1 database,
# which contains real child records. Neither may enter version control.
.dev.vars
.dev.vars.*
!.dev.vars.example
.wrangler/

# Database dumps (see spec.md 12.2) — real data, never commit
backup-*.sql
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Environment
.env
.env.*
!.env.example

# Tests
coverage/

# Images (project images belong under docs/)
*.jpeg
*.jpg
*.png
!docs/**/*.png

# Editors and OS
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
.claude/settings.local.json
