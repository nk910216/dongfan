# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-types/
build/
*.tsbuildinfo

# Cloudflare Wrangler
# .dev.vars holds local secrets; .wrangler/ holds the local D1 database,
# which contains real child records. Neither may enter version control.
.dev.vars
.dev.vars.*
!.dev.vars.example
.wrangler/

# Database dumps (see spec.md 12.2) — real data, never commit
backup-*.sql
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Environment
.env
.env.*
!.env.example

# Tests
coverage/

# Images (project images belong under docs/)
*.jpeg
*.jpg
*.png
!docs/**/*.png
# Except the home screen icons, which are part of the app rather than
# illustrations of it. Drawn by scripts/make-icons.mjs and committed:
# without them the manifest is incomplete, no install prompt appears, and
# iOS falls back to a screenshot of the page (spec 9.6).
!packages/web/public/*.png

# Editors and OS
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
.claude/settings.local.json
